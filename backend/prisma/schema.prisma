datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TECHNICIAN
  SALES
  MANAGER
  ACCOUNTANT
  ADMIN
  IT_ADMIN
  CRM
  SERVICE_MANAGER
  HR
}

model User {
  id           String             @id @default(uuid())
  employeeCode String             @unique
  name         String
  email        String             @unique
  password     String
  role         Role               @default(TECHNICIAN)
  phone        String?
  department   String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  schedules          EmployeeSchedule[]
  attendances        Attendance[]
  attendanceRequests AttendanceRequest[]  @relation("EmployeeRequests")
  reviewedRequests   AttendanceRequest[]  @relation("ReviewedRequests")
  quotations         Quotation[]
  auditLogs          AttendanceAuditLog[] @relation("AuditUser")
  performedAudits    AttendanceAuditLog[] @relation("AuditPerformer")
  notifications      AppNotification[]
  deviceTokens       DevicePushToken[]
  stockRequirements  StockRequirement[]   @relation("SalesStockRequirements")
  createdServiceIntakes  ServiceIntake[]      @relation("IntakeCreatedBy")
  closedServiceIntakes   ServiceIntake[]      @relation("IntakeClosedBy")
  assignedServiceItems   ServiceIntakeItem[]  @relation("ItemResponsibleEmployee")
  closedServiceItems     ServiceIntakeItem[]  @relation("ItemClosedBy")
  uploadedIntakeImages   ServiceIntakeImage[] @relation("ImageUploadedBy")
  performedIntakeEvents  ServiceIntakeEvent[] @relation("EventPerformedBy")
  createdServiceOptions  ServiceIntakeOption[] @relation("ServiceOptionCreatedBy")
}

model EmployeeSchedule {
  id           String   @id @default(uuid())
  employeeId   String
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String   // "09:00"
  endTime      String   // "20:00"
  isWorkingDay Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model GovernmentHoliday {
  id          String   @id @default(uuid())
  date        String   @unique // YYYY-MM-DD
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfficeConfig {
  id                  String   @id @default(uuid())
  officeName          String   @default("ECDIAL Headquarters")
  address             String?  @db.Text
  latitude            Float    @default(13.0827)
  longitude           Float    @default(80.2707)
  allowedRadiusMeters Float    @default(100.0)
  qrRotationSeconds   Int      @default(30)
  isDefault           Boolean  @default(true)
  slotIndex           Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Attendance {
  id                     String    @id @default(uuid())
  employeeId             String
  date                   String    // YYYY-MM-DD
  officeId               String?
  officeName             String?
  checkInTime            DateTime?
  checkInMethod          String    @default("QR")
  checkInDistance        Float?
  checkInGpsAccuracy     Float?
  checkInLatitude        Float?
  checkInLongitude       Float?
  checkOutTime           DateTime?
  checkOutDistance       Float?
  checkOutGpsAccuracy    Float?
  checkOutLatitude       Float?
  checkOutLongitude      Float?
  workingDurationMinutes Int?
  status                 String    @default("PRESENT") // PRESENT, ABSENT, WAITING_FOR_APPROVAL, INCOMPLETE, HOLIDAY, WEEKLY_OFF
  otMinutes              Int       @default(0)
  otStatus               String    @default("NONE") // NONE, OT_PENDING_APPROVAL, OT_APPROVED, OT_REJECTED
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee               User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model AttendanceRequest {
  id            String    @id @default(uuid())
  employeeId    String
  requestType   String    // "CHECKIN_FAILURE", "CHECKOUT_CORRECTION", "MULTI_DAY_MISSED"
  dates         String    // JSON array of strings e.g. "[\"2026-08-18\",\"2026-08-19\"]"
  checkInTime   String?   // "09:00"
  checkOutTime  String?   // "18:00"
  reason        String
  remarks       String?
  status        String    @default("WAITING_FOR_APPROVAL") // WAITING_FOR_APPROVAL, APPROVED, REJECTED
  reviewedById  String?
  reviewedAt    DateTime?
  reviewRemarks String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      User      @relation("EmployeeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy    User?     @relation("ReviewedRequests", fields: [reviewedById], references: [id])
}

model AttendanceAuditLog {
  id            String   @id @default(uuid())
  employeeId    String?
  employeeName  String
  action        String   // "CHECK_IN", "CHECK_OUT", "REQUEST_SUBMITTED", "REQUEST_APPROVED", "REQUEST_REJECTED", "OT_APPROVED", "OT_REJECTED", "SCHEDULE_UPDATED", "OFFICE_CONFIG_UPDATED"
  date          String   // YYYY-MM-DD
  timestamp     DateTime @default(now())
  method        String?  // "QR", "MANUAL_APPROVAL", "SYSTEM"
  distance      Float?
  gpsAccuracy   Float?
  performedById String?
  details       String?  @db.Text
  createdAt     DateTime @default(now())

  employee      User?    @relation("AuditUser", fields: [employeeId], references: [id])
  performedBy   User?    @relation("AuditPerformer", fields: [performedById], references: [id])
}

model Product {
  id             String   @id @default(uuid())
  name           String
  model          String?
  category       String   @default("MAIN_UNIT") // MAIN_UNIT, LOW_SIDE
  description    String   @db.Text
  defaultUnit    String   @default("Nos")
  defaultPrice   Float
  availableStock Int      @default(10)
  imageUrl       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  stockRequirements  StockRequirement[]
  serviceIntakeItems ServiceIntakeItem[]
}

model Customer {
  id        String      @id @default(uuid())
  name      String?
  address   String?     @db.Text
  mobile    String?
  email     String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  quotations        Quotation[]
  stockRequirements StockRequirement[]
  serviceIntakes    ServiceIntake[]

  @@index([createdAt(sort: Desc)])
  @@index([mobile])
}

model Quotation {
  id                  String          @id @default(uuid())
  quotationNumber     String          @unique // e.g. "ECD-Q-2026-00124"
  revisionNumber      Int             @default(1)
  originalQuotationId String?
  date                String          // YYYY-MM-DD
  customerId          String?
  customerName        String          @default("")
  customerAddress     String          @default("") @db.Text
  customerPhone       String?
  customerEmail       String?
  customerLocation    String?
  createdById         String
  quotationType       String          @default("DAIKIN") // "DAIKIN" or "ECDIAL"
  hasLowSide          Boolean         @default(false)
  mainUnitTotal       Float           @default(0.0)
  lowSideTotal        Float           @default(0.0)
  subtotal            Float           @default(0.0)
  cgstPercent         Float           @default(9.0)
  cgstAmount          Float           @default(0.0)
  sgstPercent         Float           @default(9.0)
  sgstAmount          Float           @default(0.0)
  grandTotal          Float           @default(0.0)
  termsAndConditions  String          @db.Text
  paymentMethod       String          @db.Text
  status              String          @default("DRAFT") // DRAFT, FINAL, SENT, ACCEPTED, REJECTED, EXPIRED
  pdfName             String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy           User            @relation(fields: [createdById], references: [id])
  items               QuotationItem[]
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  section     String    // "MAIN_UNIT" or "LOW_SIDE"
  productId   String?
  brand       String?   // "Daikin", "Mitsubishi", "LG", "General", "Godrej", "Onida"
  itemOrder   Int       @default(0)
  description String    @db.Text
  quantity    Float     @default(1.0)
  unit        String    @default("Nos")
  unitPrice   Float     @default(0.0)
  amount      Float     @default(0.0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationConfig {
  id                   String   @id @default(uuid())
  defaultCgstPercent   Float    @default(9.0)
  defaultSgstPercent   Float    @default(9.0)
  defaultTerms         String   @db.Text
  defaultPaymentMethod String   @db.Text
  availableUnits       String   @default("Nos,Mtr,Sqft,Kg,Set,Box,Piece,Hour,Service,Other")
  updatedAt            DateTime @updatedAt
}

model AppNotification {
  id           String   @id @default(uuid())
  userId       String
  title        String
  message      String   @db.Text
  type         String   // "ATTENDANCE_NOT_MARKED", "ATTENDANCE_REQUEST_CREATED", "ATTENDANCE_REQUEST_ACCEPTED", "ATTENDANCE_TIME_EDITED", "ATTENDANCE_CLOSING_REQUIRED", "QUOTATION_CREATED", "SYSTEM_NOTIFICATION"
  entityId     String?  // ID of related entity (e.g. attendanceRequestId, quotationId)
  entityType   String?  // "ATTENDANCE_REQUEST", "QUOTATION", "ATTENDANCE", "STOCK", "CUSTOMER"
  targetScreen String?  // Deep-link screen key (e.g. "ADMIN_APPROVALS", "ATTENDANCE_REQUEST", "QUOTATION_PREVIEW")
  metadata     String?  @db.Text // JSON string for extra payload parameters
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

model DevicePushToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   // Expo Push Token e.g. "ExponentPushToken[xxxxxxxxxxxxxx]"
  platform    String   @default("android") // "android", "ios", "web"
  deviceId    String?  // Hardware / installation identifier
  deviceModel String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([token])
  @@index([userId, isActive])
}

model StockRequirement {
  id          String   @id @default(uuid())
  salesUserId String
  customerId  String
  productId   String
  quantity    Int
  requestedAt DateTime @default(now())
  priority    String   @default("NORMAL") // "NORMAL", "URGENT", "EMERGENCY"
  status      String   @default("PENDING") // "PENDING", "ORDERED", "RECEIVED", "COMPLETED"
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesUser   User     @relation("SalesStockRequirements", fields: [salesUserId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([salesUserId])
  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([priority])
  @@index([requestedAt(sort: Desc)])
}

model Catalogue {
  id           String   @id @default(uuid())
  displayName  String
  fileName     String
  model        String?
  category     String   @default("Catalogue") // Catalogue, Brochure, Product Document, Other
  description  String?  @db.Text
  uploadedById String?
  fileSize     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayName])
  @@index([category])
}

// ============================================================
// SERVICE INTAKE — rebuilt models
// ============================================================

model ServiceIntake {
  id           String   @id @default(uuid())
  intakeNumber String   @unique // e.g. "SI-000001"

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?   // legacy fallback display only; new rows always set customerId

  siteName     String?   // canonical tag value, e.g. "Project Site"
  problems     String[]  // one or more canonical problem tags; ["Unknown Problem"] if none given
  takingTo     String?   // "SHOWROOM" | "OFFICE" | "SERVICE_CENTER"

  status       String    @default("NOT_STARTED") // legacy/derived service stage; item statuses are authoritative
  lifecycleStatus String  @default("OPEN") // OPEN, CLOSED, ARCHIVED
  notes        String?   @db.Text

  receivedAt   DateTime  @default(now())
  closedAt     DateTime?
  closedById   String?
  closedBy     User?     @relation("IntakeClosedBy", fields: [closedById], references: [id])

  archivedAt   DateTime?

  createdById  String    // reporting person — always the authenticated creator
  createdBy    User      @relation("IntakeCreatedBy", fields: [createdById], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        ServiceIntakeItem[]
  images       ServiceIntakeImage[]
  events       ServiceIntakeEvent[]

  @@index([intakeNumber])
  @@index([customerId])
  @@index([receivedAt(sort: Desc)])
  @@index([status])
  @@index([archivedAt])
  @@index([createdById])
}

model ServiceIntakeItem {
  id                      String    @id @default(uuid())
  intakeId                String
  intake                  ServiceIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  itemType                String    // "INDOOR_UNIT" | "OUTDOOR_UNIT" (legacy rows may hold MOTOR/PCB_BOARD/OTHER)
  itemTypeLabel           String?
  itemName                String?   // display name for custom/generic items, e.g. "Capacitor"
  identifierType          String?   // e.g. Serial Number, Board Number, Rating, Asset ID
  identifierValue         String?   // value corresponding to identifierType

  problems               String[]  @default([])
  productId               String?
  product                 Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productModel            String?
  serialNumber            String? 

  status                  String    @default("NOT_STARTED") // same 5 values as ServiceIntake.status

  responsibleEmployeeId   String?
  responsibleEmployeeName String?
  responsibleEmployee     User?     @relation("ItemResponsibleEmployee", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)

  notes                   String?   @db.Text

  closedAt                DateTime?
  closedById               String?
  closedBy                User?     @relation("ItemClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  images                  ServiceIntakeImage[]
  events                  ServiceIntakeEvent[]

  @@index([intakeId])
  @@index([productId])
  @@index([serialNumber])
  @@index([status])
  @@index([responsibleEmployeeId])
}

model ServiceIntakeImage {
  id              String             @id @default(uuid())
  intakeId        String
  intake          ServiceIntake      @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  itemId          String?            // null = photo attached to the intake itself, not one unit
  item            ServiceIntakeItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  imageUrl        String
  storageFileName String
  fileSize        Int?
  uploadedById    String?
  uploadedBy      User?              @relation("ImageUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([intakeId])
  @@index([itemId])
}

model ServiceIntakeEvent {
  id              String             @id @default(uuid())
  intakeId        String
  itemId          String?
  eventType       String             // "INTAKE_CREATED", "ITEM_ADDED", "ITEM_UPDATED", "PRODUCT_CHANGED", "SERIAL_CHANGED", "IMAGE_ADDED", "IMAGE_REMOVED", "STATUS_CHANGED", "SITE_CHANGED", "PROBLEMS_CHANGED", "TAKING_TO_CHANGED", "NOTES_CHANGED", "CUSTOMER_CHANGED", "RESPONSIBLE_CHANGED", "NOTE_ADDED", "ARCHIVED"
  title           String
  description     String?            @db.Text
  oldValue        String?
  newValue        String?
  metadata        String?            @db.Text
  performedById   String?
  performedByName String
  createdAt       DateTime           @default(now())

  intake          ServiceIntake      @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  item            ServiceIntakeItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy     User?              @relation("EventPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([intakeId])
  @@index([itemId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
}

model ServiceIntakeOption {
  id          String   @id @default(uuid())
  kind        String   // "SITE" | "PROBLEM"
  label       String
  createdById String?
  createdBy   User?    @relation("ServiceOptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([kind, label])
  @@index([kind])
}
